<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XAvalonia.Sample.Views"
             x:Class="XAvalonia.Sample.Views.DocumentView"
             x:DataType="vm:DocumentViewModel">

  <TextBox Text="{Binding Content}"
           AcceptsReturn="True"
           AcceptsTab="{Binding EditorSettings.AcceptsTab}"
           TextWrapping="{Binding EditorSettings.WordWrap}"
           FontFamily="{Binding EditorSettings.FontFamily}"
           FontSize="{Binding EditorSettings.FontSize}"
           Margin="4"
           BorderThickness="0"
           Background="Transparent" />

</UserControl>
