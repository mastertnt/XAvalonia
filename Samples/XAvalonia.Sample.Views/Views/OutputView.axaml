<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XAvalonia.Sample.Views"
             x:Class="XAvalonia.Sample.Views.OutputView"
             x:DataType="vm:OutputViewModel">

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Sortie" Classes="panelHeader" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
      <TextBlock Text="{Binding Log}"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="12"
                 Margin="8"
                 TextWrapping="NoWrap" />
    </ScrollViewer>
  </DockPanel>

</UserControl>
