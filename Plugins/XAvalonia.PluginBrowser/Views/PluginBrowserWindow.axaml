<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PluginBrowser.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="PluginBrowser.Views.PluginBrowserView"
             x:DataType="vm:PluginBrowserViewModel">

  <Grid RowDefinitions="*,Auto">

    <!-- Plugin tree -->
    <TreeView Grid.Row="0"
              ItemsSource="{Binding Plugins}"
              SelectedItem="{Binding SelectedPlugin}"
              Margin="8,8,8,0">

      <TreeView.Styles>
        <Style Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="True" />
        </Style>
      </TreeView.Styles>

      <TreeView.DataTemplates>

        <!-- Plugin node -->
        <TreeDataTemplate x:DataType="vm:PluginViewModel"
                          ItemsSource="{Binding ServiceNodes}">
          <StackPanel Margin="0,3"
                      ToolTip.Tip="{Binding AssemblyLocation}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <iconPacks:PackIconMaterial Kind="Puzzle"
                                         Width="16" Height="16"
                                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}"
                         FontWeight="SemiBold"
                         MinWidth="150" />
              <TextBlock Text="{Binding Id}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         MinWidth="200" />
              <TextBlock Text="{Binding CurrentVersion}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Text="→"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Text="{Binding AvailableVersion}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Description}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,2,0,0" />
          </StackPanel>
        </TreeDataTemplate>

        <!-- Service node -->
        <DataTemplate x:DataType="vm:ServiceNodeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,1">
            <iconPacks:PackIconMaterial Kind="Handshake"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IconColor}" />
            <TextBlock Text="{Binding TypeName}" />
          </StackPanel>
        </DataTemplate>

      </TreeView.DataTemplates>
    </TreeView>

    <!-- Footer: loading indicator -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,6,12,8"
                IsVisible="{Binding IsLoadingVersions}">
      <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" />
      <TextBlock Text="Checking for updates…" VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

  </Grid>

</UserControl>
