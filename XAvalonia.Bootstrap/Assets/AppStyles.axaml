<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Status bar ──────────────────────────────────────────────────────── -->
  <Style Selector="Border.statusBar">
    <Setter Property="Background"  Value="#2d2d2d" />
    <Setter Property="BorderBrush" Value="#3e3e3e" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding"     Value="6,3" />
    <Setter Property="Height"      Value="24" />
  </Style>

  <Style Selector="TextBlock.statusItem">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize"  Value="11" />
    <Setter Property="Foreground" Value="#d4d4d4" />
    <Setter Property="Margin"    Value="6,0" />
  </Style>

  <Style Selector="TextBlock.statusRight">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="12,0,6,0" />
  </Style>

  <Style Selector="Separator.statusSep">
    <Setter Property="Background" Value="#555555" />
    <Setter Property="Width"      Value="1" />
    <Setter Property="Margin"     Value="0,3" />
  </Style>

  <!-- ── Panneau header ──────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="Background"  Value="#252525" />
    <Setter Property="Foreground"  Value="#c0c0c0" />
    <Setter Property="FontSize"    Value="11" />
    <Setter Property="FontWeight"  Value="SemiBold" />
    <Setter Property="Padding"     Value="8,4" />
  </Style>

  <!-- ── Propriétés grid ─────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.propLabel">
    <Setter Property="Foreground" Value="#808080" />
    <Setter Property="FontSize"   Value="11" />
    <Setter Property="Margin"     Value="0,4,12,0" />
  </Style>

  <Style Selector="TextBlock.propValue">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin"   Value="0,4,0,0" />
  </Style>

</Styles>
